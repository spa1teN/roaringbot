# =============================================================================
# RoaringBot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- Required ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- Discord ---
# GUILD_ID=                    # Override guild ID (optional)
# BOT_OWNER_ID=485051896655249419
# LOG_LEVEL=INFO               # DEBUG, INFO, WARNING, ERROR

# --- Esports (wannspieltbig.de integration) ---
# ESPORTS_ENABLED=true
# ESPORTS_GUILD_ID=            # Guild for Discord events (uses GUILD_ID if unset)
# ESPORTS_SUMMARY_CHANNEL_ID=  # Channel for reminders & weekly summary
# ESPORTS_UPDATE_CHANNEL_ID=   # Channel for duplicate-event scan updates
# ESPORTS_FORUM_CHANNEL_ID=    # Forum channel for match-thread reminders
# ESPORTS_VC1=                 # Voice channel 1 for "VC 1" events
# ESPORTS_VC2=                 # Voice channel 2 for "VC 2" events
# ESPORTS_API_URL=https://wannspieltbig.de/api/match_upcoming/
# ESPORTS_POLL_INTERVAL_MINUTES=5
# SHARE_BASE_URL=https://bot.wannspieltbig.de   # Basis-URL der öffentlichen Share-Seiten (für den WhatsApp-Ping-Button; die Seiten selbst laufen im wannspieltbig-social-preview-Service)
# WSB_User=                    # Basic auth username for wannspieltbig PUTs
# WSB_PW=                      # Basic auth password for wannspieltbig PUTs
# PING_CS=                     # Role ID for CS game ping
# PING_LOL=                    # Role ID for LoL game ping
# PING_TM=                     # Role ID for TM game ping
# REMINDER_PING_DELAY=60       # Seconds delay between reminder post and role ping
# PING_WHATSAPP=               # Channel ID for 45-min WhatsApp reminder ping

# --- Birthday ---
# BIRTHDAY_CHANNEL_ID=
# BIRTHDAY_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=config/google_credentials.json
# BIRTHDAY_EMOTE_ID=           # Emote ID only (name "tabsSax" is hardcoded)

# --- Kassenbuch / Finance ---
# KASSENBUCH_SPREADSHEET_ID=
# KASSENBUCH_WORKSHEET_NAME=Kassenbuch
# KASSENBUCH_SERVICE_ACCOUNT_FILE=config/kassenbuch_credentials.json
# KASSENBUCH_CHANNEL_ID=

# --- Database (Postgres) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=roaringbot
# DB_USER=roaringbot
# DB_PASSWORD=                  # Required

# --- HTTP Client ---
# HTTP_TIMEOUT=30
# MAX_HTTP_CONNECTIONS=100
# MAX_HTTP_CONNECTIONS_PER_HOST=10

# --- Cache ---
# MAX_CACHE_SIZE_MB=100
# MAX_MEMORY_CACHE_ITEMS=50
